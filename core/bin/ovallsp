#!/usr/bin/env ruby
# frozen_string_literal: true

# ADR-0004: a packaged VSIX vendors Core's own runtime gem dependencies
# (prism, rbs) into vendor/bundle alongside this script
# (vscode/scripts/copy-core.js), so a bundle-free launch never needs the
# end user to have run `bundle install` themselves, or even have Bundler
# installed at all. Deliberately hand-rolled (not `require "bundler/setup"`)
# since Bundler itself might not be installed in whatever Ruby
# resolveRuby picked; only ever *adds* to $LOAD_PATH when a vendored gem
# is actually present, so a non-packaged dev checkout (no vendor/bundle
# directory at all) falls through unchanged to ordinary `bundle exec`/
# already-installed-gems resolution, exactly the pre-Task-020 behavior.
#
# ADR-0005: vendor/bundle's native extensions are specific to whatever
# Ruby engine/version/OS/CPU built them, so this only actually adds them
# to $LOAD_PATH once VendorCompatibility confirms the *running*
# interpreter matches -- an unconditional add here previously let a
# cross-ABI mismatch surface as an undiagnosable crash deep inside the
# process instead of a clear message.
# The bootstrap itself lives in VendorBootstrap so it can be tested: this
# script only ever runs as a subprocess, and which directories a payload
# contributes is a decision with more than one wrong answer -- see that
# file for the ABI one that a two-Ruby dev checkout used to hit.
require_relative "../lib/ovallsp/vendor_bootstrap"

Ovallsp::VendorBootstrap.activate!(
  vendor_root: File.expand_path("../vendor/bundle", __dir__),
  manifest_path: File.expand_path("../PLATFORM_MANIFEST.json", __dir__)
)

require "optparse"
require_relative "../lib/ovallsp"

stdio = false

OptionParser.new do |opts|
  opts.banner = "Usage: ovallsp --stdio"
  opts.on("--stdio", "Communicate over stdin/stdout") { stdio = true }
end.parse!(ARGV)

unless stdio
  warn "ovallsp: only the --stdio transport is currently supported"
  exit 1
end

$stdin.binmode
$stdout.binmode
$stdout.sync = true

logger = Ovallsp::Logger.new(io: $stderr)

# Server decides whether/when to start the Runtime Agent itself, once it
# knows from the `initialize` request whether the client considers this
# workspace trusted (docs/02-architecture.md section 11) — it isn't safe
# to launch Rails/Bundler code before that's known, so this script doesn't
# do it eagerly here.
server = Ovallsp::Server.new(input: $stdin, output: $stdout, logger: logger, workspace_root: Dir.pwd)

exit(server.run)
