#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/rslsp"

stdio = false

OptionParser.new do |opts|
  opts.banner = "Usage: rslsp --stdio"
  opts.on("--stdio", "Communicate over stdin/stdout") { stdio = true }
end.parse!(ARGV)

unless stdio
  warn "rslsp: only the --stdio transport is currently supported"
  exit 1
end

$stdin.binmode
$stdout.binmode
$stdout.sync = true

logger = Rslsp::Logger.new(io: $stderr)
server = Rslsp::Server.new(input: $stdin, output: $stdout, logger: logger)

exit(server.run)
