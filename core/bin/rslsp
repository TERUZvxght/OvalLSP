#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "../lib/rslsp"

stdio = false

OptionParser.new do |opts|
  opts.banner = "Usage: rslsp --stdio"
  opts.on("--stdio", "Communicate over stdin/stdout") { stdio = true }
end.parse!(ARGV)

unless stdio
  warn "rslsp: only the --stdio transport is currently supported"
  exit 1
end

$stdin.binmode
$stdout.binmode
$stdout.sync = true

logger = Rslsp::Logger.new(io: $stderr)

# Server decides whether/when to start the Runtime Agent itself, once it
# knows from the `initialize` request whether the client considers this
# workspace trusted (docs/02-architecture.md section 11) — it isn't safe
# to launch Rails/Bundler code before that's known, so this script doesn't
# do it eagerly here.
server = Rslsp::Server.new(input: $stdin, output: $stdout, logger: logger, workspace_root: Dir.pwd)

exit(server.run)
