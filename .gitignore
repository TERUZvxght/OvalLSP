# Ruby
core/.bundle/
core/vendor/bundle/
*.gem

# Node / VS Code extension
vscode/node_modules/
vscode/out/
vscode/.vscode-test/

# vscode/core/ is generated at package time by vscode/scripts/copy-core.js
# (ADR-0004) -- a copy of ../core plus vendored gem dependencies, never
# source to commit.
vscode/core/
vscode/*.vsix

# Marketplace publish PAT, read by vscode/scripts/release.sh -- never
# committed, never logged. See docs/PUBLISHING.md's Credentials section.
vscode/.vsce-pat.local

# Editor / OS
.DS_Store

# Test-generated flag files (rails_minimal reload fixture)
core/spec/fixtures/rails_minimal/config/.disable_archived_route

# Real-Rails integration fixture (spec/integration/real_rails_spec.rb):
# Gemfile.lock/.bundle/db/log/tmp are environment-specific -- regenerated
# locally via `bundle install --local` before the suite runs, and skipped
# entirely if Rails/sqlite3 aren't available on the machine running specs.
core/spec/fixtures/rails_real/Gemfile.lock
core/spec/fixtures/rails_real/.bundle/
core/spec/fixtures/rails_real/db/*.sqlite3*
core/spec/fixtures/rails_real/log/
core/spec/fixtures/rails_real/tmp/

# Task source zips dropped into the workspace root are working material,
# not repo content -- never auto-commit them.
/*.zip

# Per-release working notes (session handoff: what round of review we are
# on, what to re-read next session). Working material like the zips above,
# not repo content -- root .md files are the contributor-facing EN/JA set,
# and durable decisions belong in CLAUDE.md / AGENTS.md / docs/design.
/V*_PROGRESS.md

# CI's rspec JSON output (used to detect skipped real-Rails examples)
core/tmp/

# Raw audit output kept out of the tree: 048 carries the conclusions.
.audit-048-wip/

# Agent worktrees. These are real git worktrees created inside the repository,
# so a `git add -A` would otherwise sweep an entire second checkout into the
# tree -- the same accident that committed a raw audit directory in 0.2.16.
.claude/worktrees/
