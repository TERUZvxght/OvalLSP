# Real-Rails integration fixture (spec/integration/real_rails_spec.rb):
# Gemfile.lock/.bundle/db/log/tmp are environment-specific -- regenerated
# locally via `bundle install --local` before the suite runs, and skipped
# entirely if Rails/sqlite3 aren't available on the machine running specs.
core/spec/fixtures/rails_real/Gemfile.lock
core/spec/fixtures/rails_real/.bundle/
core/spec/fixtures/rails_real/db/*.sqlite3*
core/spec/fixtures/rails_real/log/
core/spec/fixtures/rails_real/tmp/

# Task source zips dropped into the workspace root are working material,
# not repo content -- never auto-commit them.
/*.zip
